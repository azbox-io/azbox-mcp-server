{
  "name": "azbox-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for AZbox: read a project's translations from Claude Code, Cursor and other MCP clients",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "azbox",
    "i18n",
    "l10n",
    "translations"
  ],
  "license": "MIT",
  "author": "Ricardo <ricardocaste@gmail.com>",
  "homepage": "https://azbox.io/docs/",
  "type": "module",
  "bin": {
    "azbox-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
